# Resend API key (sending access only). Get from resend.com → API Keys.
RESEND_API_KEY=

# Where enquiries are delivered, e.g. alan@example.com
ENQUIRY_TO=

# Sender. Use "Name <onboarding@resend.dev>" until the domain is verified.
ENQUIRY_FROM=

# The live site's address, without a trailing slash, e.g.
# https://alangravell.com. Turns on canonical links, link-preview images and
# the sitemap. Leave empty until the domain is decided.
NEXT_PUBLIC_SITE_URL=
